{
    "name": "pindustries/suncharts-sdk-php",
    "description": "PHP SDK for the SunCharts public API (partner credentials, OAuth2 client credentials, PSR-18).",
    "type": "library",
    "license": "MIT",
    "keywords": ["suncharts", "openemr", "fhir", "psr-18", "sdk"],
    "require": {
        "php": "^8.2",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": { "psr-4": { "PIndustries\\SunCharts\\": "src/" } },
    "autoload-dev": { "psr-4": { "PIndustries\\SunCharts\\Tests\\": "tests/" } },
    "config": { "allow-plugins": { "php-http/discovery": false }, "sort-packages": true },
    "scripts": { "test": "phpunit", "stan": "phpstan analyse src --level=8" }
}
