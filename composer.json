{
    "name": "pindustries/suncharts-sdk-php",
    "description": "PHP SDK for the SunCharts public API: operations generated from the OpenAPI spec + PSR-18 client with OAuth2 client credentials, API keys and relay.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "suncharts",
        "openemr",
        "fhir",
        "psr-18",
        "sdk"
    ],
    "require": {
        "php": "^8.2",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "php-http/discovery": "^1.19",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "PIndustries\\SunCharts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PIndustries\\SunCharts\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse src --level=8",
        "generate": "scripts/generate.sh"
    }
}
